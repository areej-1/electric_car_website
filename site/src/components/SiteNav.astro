---
import { Image } from 'astro:assets';
import { tk } from '../i18n/t.js';
import logo from '../assets/cobra-race-mark.png';
const { lang = 'en', page = 'index' } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === 'ar' ? `${base}/ar` : base;

// A reduced phase-1 shell, not a straight port of cobras-lib.js's NAV_ITEMS.
// `game` and `about` are intentionally left out of the top nav — `about` lives
// in the footer instead, and `game` has no phase-1 home yet. The full
// information architecture is settled in phase 3, against the complete page set.
// Labels resolve through tk() against cobras-lib.js's key-based STRINGS map
// (extracted into i18n/keys.js) rather than arabic.js's English-keyed COMMON —
// that's the map that actually carries chrome translations.
const NAV = [
  { key: 'index', i18nKey: 'nav.home', href: '/' },
  { key: 'members', i18nKey: 'nav.members', href: '/members' },
  { key: 'projects', i18nKey: 'nav.work', href: '/projects' },
  { key: 'specs', i18nKey: 'nav.specs', href: '/specs' },
  { key: 'sponsors', i18nKey: 'nav.sponsors', href: '/sponsors' },
];
const RESOURCES = [
  { key: 'race-day', i18nKey: 'nav.raceDay', href: '/race-day' },
  { key: 'news', i18nKey: 'nav.news', href: '/news' },
  { key: '101', i18nKey: 'nav.learn', href: '/101' },
  { key: 'checklist', i18nKey: 'nav.checklist', href: '/checklist' },
];
const other = lang === 'ar' ? 'English' : 'العربية';
const otherHref = lang === 'ar' ? `${base}/` : `${base}/ar/`;
---
<nav class="site-nav" aria-label={tk(lang, 'nav.main')}>
  <div class="shell nav-inner">
    <a class="brand" href={prefix || '/'}>
      <Image src={logo} alt="SIS Al Jada Cobras" width={36} height={36} format="webp" loading="eager" />
    </a>
    <ul class="nav-list">
      {NAV.map((item) => (
        <li>
          <a href={`${prefix}${item.href}`} aria-current={item.key === page ? 'page' : undefined}>
            {tk(lang, item.i18nKey)}
          </a>
        </li>
      ))}
      <li class="has-sub">
        <button type="button" class="has-sub-trigger" aria-haspopup="true">{tk(lang, 'nav.resources')}</button>
        <ul>
          {RESOURCES.map((item) => (
            <li><a href={`${prefix}${item.href}`}>{tk(lang, item.i18nKey)}</a></li>
          ))}
        </ul>
      </li>
    </ul>
    <a class="lang-switch" href={otherHref} lang={lang === 'ar' ? 'en' : 'ar'}>{other}</a>
  </div>
</nav>

<style>
  .site-nav { position: sticky; top: 0; z-index: 40; background: rgba(10,10,10,.88);
              backdrop-filter: blur(8px); border-bottom: 1px solid rgba(154,163,168,.18); }
  .nav-inner { display: flex; align-items: center; gap: 1.5rem; min-height: 60px; }
  .nav-list { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; flex: 1; }
  .nav-list a { text-decoration: none; font-size: var(--step--1); }
  .nav-list a[aria-current='page'] { color: var(--hot); }
  .lang-switch { font-family: var(--font-display); font-size: var(--step--1);
                 border: 1px solid var(--gold); padding: 6px 12px; text-decoration: none; }
  .brand img { display: block; }

  /* Resources is a CSS-only disclosure, not a raw nested list: the trigger is a
     real <button> (keyboard-reachable by default), and the submenu is positioned
     off-flow and hidden via opacity/pointer-events rather than display/visibility,
     so it stays in the tab order and opens the instant the button — its first
     descendant — receives focus, before Tab moves any further into it. */
  .has-sub { position: relative; }
  .has-sub-trigger { font: inherit; font-size: var(--step--1); color: inherit;
                      background: none; border: 0; padding: 0; cursor: pointer; }
  .has-sub > ul { position: absolute; top: 100%; inset-inline-start: 0; z-index: 10;
                  min-width: 180px; margin: 8px 0 0; padding: 8px 0; list-style: none;
                  background: var(--panel); border: 1px solid rgba(154,163,168,.18);
                  opacity: 0; pointer-events: none; transform: translateY(-4px);
                  transition: opacity .15s ease, transform .15s ease; }
  .has-sub:hover > ul, .has-sub:focus-within > ul {
    opacity: 1; pointer-events: auto; transform: translateY(0);
  }
  .has-sub > ul a { display: block; padding: 8px 16px; white-space: nowrap; }

  @media (max-width: 760px) { .nav-list { display: none; } }
</style>
